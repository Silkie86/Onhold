{
  "providerId": "onhold.example",
  "providerName": "OnHold",
  "serviceId": "sending",
  "serviceName": "Email from your domain",
  "version": 1,
  "description": "Lets OnHold send your business's email from your own domain: a DKIM key, and SPF with a bounce address on a send subdomain. A DMARC policy that changes nothing is added only if the domain has none.",
  "variableDescription": "dkim: the DKIM public key (p=...). mx: the bounce server of the sending region, such as feedback-smtp.eu-west-1.amazonses.com.",
  "syncBlock": false,
  "syncPubKeyDomain": "domainconnect.onhold.example",
  "syncRedirectDomain": "app.onhold.example",
  "hostRequired": false,
  "records": [
    {
      "groupId": "send",
      "type": "TXT",
      "host": "resend._domainkey",
      "data": "%dkim%",
      "ttl": 3600,
      "txtConflictMatchingMode": "All"
    },
    {
      "groupId": "send",
      "type": "MX",
      "host": "send",
      "pointsTo": "%mx%",
      "priority": 10,
      "ttl": 3600
    },
    {
      "groupId": "send",
      "type": "TXT",
      "host": "send",
      "data": "v=spf1 include:amazonses.com ~all",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=spf1"
    },
    {
      "groupId": "dmarc",
      "type": "TXT",
      "host": "_dmarc",
      "data": "v=DMARC1; p=none;",
      "ttl": 3600,
      "txtConflictMatchingMode": "Prefix",
      "txtConflictMatchingPrefix": "v=DMARC1"
    }
  ]
}
