  "query": "SELECT id, kind, key, locale, name, subject, body, description, version, created_at, updated_at\n           FROM templates\n           WHERE workspace_id = app_workspace_id() AND archived_at IS NULL\n             AND ($1::text IS NULL OR kind = $1)\n           ORDER BY key, locale",
