  "query": "SELECT id, auth_method, ip AS \"ip: IpAddr\", user_agent, created_at, last_seen_at, expires_at\n           FROM sessions\n           WHERE user_id = $1 AND revoked_at IS NULL AND expires_at > now()\n           ORDER BY last_seen_at DESC",
