  "query": "SELECT id, provider, purposes, owner_id AS \"owner_id: UserId\", account, shared_mailbox, shared,\n                      display_name, settings, secret, scopes, status, failures, last_error, last_error_at,\n                      last_synced_at, mail_cursor, mail_since, next_poll_at, connected_at, disconnected_at, version\n               FROM integrations WHERE workspace_id = app_workspace_id() AND provider = $1 AND coalesce(shared_mailbox, account) = $2 AND owner_id = $3\n         AND disconnected_at IS NOT NULL ORDER BY disconnected_at DESC LIMIT 1 FOR UPDATE",
