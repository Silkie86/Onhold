{
  "db_name": "PostgreSQL",
  "query": "SELECT w.id AS \"id: WorkspaceId\", w.slug, w.name, w.status AS \"status: WorkspaceStatus\",\n                  m.role AS \"role: Role\"\n           FROM memberships m JOIN workspaces w ON w.id = m.workspace_id\n           WHERE m.user_id = $1 AND m.deleted_at IS NULL AND w.status <> 'closed'\n           ORDER BY w.name",
