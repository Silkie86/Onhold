# Copy to .env for running the binary or tests outside Docker.
DATABASE_URL=postgres://onhold:onhold@localhost:5432/onhold
LOG_FORMAT=pretty
RUST_LOG=info

# Where the web app is served; invitation and sign-in links point here.
PUBLIC_BASE_URL=http://localhost:5173
# Plain HTTP in local development only.
COOKIE_SECURE=false
# Where the client IP (audit log, sessions, quote acceptance) comes from. false: the
# connection. true: the last X-Forwarded-For entry, behind a proxy that appends to it
# (nginx, Caddy, a load balancer). cloudflare: CF-Connecting-IP, only when every request
# comes through Cloudflare.
# TRUST_PROXY_HEADERS=false
# Keys for secrets at rest (TOTP seeds). Generate: `cargo run -p onhold -- admin generate-key`
ENCRYPTION_KEYS=

# Outgoing mail. Unset, the worker writes emails to its log instead (links removed);
# required when PUBLIC_BASE_URL is https.
# Locally, run Mailpit (`docker compose -f infra/docker-compose.yml up mailpit`) and open http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=OnHold <no-reply@onhold.localhost>
# Jobs one worker runs at once.
# WORKER_CONCURRENCY=8
# Let webhooks reach localhost and private networks. Local development only.
WEBHOOKS_ALLOW_PRIVATE=true

# Optional sign-in providers. Redirect URI: <PUBLIC_BASE_URL>/api/v1/auth/oidc/<google|microsoft>/callback
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=
# OIDC_MICROSOFT_TENANT=organizations
# The same Google and Microsoft apps connect members' mailboxes for the inbox.
# Add the redirect URI <PUBLIC_BASE_URL>/settings/email to each, and the Gmail API
# (gmail.readonly, gmail.send) or Microsoft Graph (Mail.Read, Mail.Send, User.Read,
# offline_access; Mail.Read.Shared and Mail.Send.Shared for shared mailboxes).
# How often connected mailboxes are read, in seconds (30 to 3600).
# MAIL_POLL_SECONDS=120
# How far back a newly connected mailbox is read, in days (0 to 365).
# MAIL_FIRST_READ_DAYS=30
# They also connect talent's own calendars (busy times only): add the redirect URI
# <PUBLIC_BASE_URL>/connect-calendar, Google's Calendar API (calendar.freebusy) and
# Microsoft Graph's Calendars.ReadBasic. How often each is read, in seconds (60 to 21600).
# CALENDAR_POLL_SECONDS=900

# Desktop and mobile apps. Plans whose workspaces may use them (comma-separated);
# unset, every plan may.
# APP_PLANS=pro,agency
# How long an app stays signed in without being used, in days.
# APP_SESSION_TTL_DAYS=90
# Extra web origins allowed to call the API across origins, beside the apps' own
# (tauri://localhost and friends). Bare origins, comma-separated. For `pnpm app:dev`:
# CORS_ORIGINS=http://localhost:5173

# Card payments through Stripe Connect (Standard accounts). Set all three, or none.
# In the Stripe dashboard: Connect → Settings gives the client id; add the redirect
# URI <PUBLIC_BASE_URL>/settings/payments; add a webhook endpoint at
# <API>/api/v1/webhooks/stripe that listens to events on connected accounts, for
# checkout.session.*, charge.refunded, account.updated and
# account.application.deauthorized.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_CLIENT_ID=ca_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# OnHold's cut of each card payment, in hundredths of a percent (150 = 1.5%). Default 0.
# STRIPE_APPLICATION_FEE_BPS=0

# Sending from workspaces' own domains (M6). Needs SMTP_URL to be Resend's
# SMTP server (smtp://resend:<key>@smtp.resend.com:587) with the same account.
# RESEND_API_KEY=re_...
# RESEND_REGION=eu-west-1
# One-step DNS setup through Domain Connect (docs/domain-connect/).
# DOMAIN_CONNECT_PROVIDER_ID=onhold.example
# DOMAIN_CONNECT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
