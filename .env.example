# Copy to .env for running the binary or tests outside Docker.
DATABASE_URL=postgres://onhold:onhold@localhost:5432/onhold
LOG_FORMAT=pretty
RUST_LOG=info

# Where the web app is served; invitation and sign-in links point here.
PUBLIC_BASE_URL=http://localhost:5173
# Plain HTTP in local development only.
COOKIE_SECURE=false
# Keys for secrets at rest (TOTP seeds). Generate: `cargo run -p onhold -- admin generate-key`
ENCRYPTION_KEYS=

# Optional sign-in providers. Redirect URI: <PUBLIC_BASE_URL>/api/v1/auth/oidc/<google|microsoft>/callback
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=
# OIDC_MICROSOFT_TENANT=organizations
